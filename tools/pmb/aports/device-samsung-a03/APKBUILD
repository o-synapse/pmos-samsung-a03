# Reference: <https://postmarketos.org/devicepkg>
pkgname=device-samsung-a03
pkgdesc="Samsung Galaxy A03 (SM-A035F)"
pkgver=1
pkgrel=8
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	iw
	linux-samsung-a03
	postmarketos-base
	stevia-schemas
	wpa_supplicant
"
makedepends="devicepkg-dev"
install="$pkgname.post-install $pkgname.post-upgrade"
source="
	deviceinfo
	60-samsung-a03-by-name.rules
	72-samsung-a03-no-audio.rules
	50-samsung-a03-networkmanager.conf
	samsung-a03-wifi.initd
	20_samsung-a03.gschema.override
	"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname
	install -Dm644 "$srcdir"/60-samsung-a03-by-name.rules \
		"$pkgdir"/usr/lib/udev/rules.d/60-samsung-a03-by-name.rules
	install -Dm644 "$srcdir"/72-samsung-a03-no-audio.rules \
		"$pkgdir"/usr/lib/udev/rules.d/72-samsung-a03-no-audio.rules
	install -Dm644 "$srcdir"/50-samsung-a03-networkmanager.conf \
		"$pkgdir"/etc/NetworkManager/conf.d/50-samsung-a03.conf
	install -Dm755 "$srcdir"/samsung-a03-wifi.initd "$pkgdir"/etc/init.d/samsung-a03-wifi
	install -Dm644 "$srcdir"/20_samsung-a03.gschema.override \
		"$pkgdir"/usr/share/glib-2.0/schemas/20_samsung-a03.gschema.override
}

