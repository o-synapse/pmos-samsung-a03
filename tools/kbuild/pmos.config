# postmarketOS requirements on top of a03_cis_open_defconfig
CONFIG_LOCALVERSION="-27193134-abA035FXXS9CYG1"
CONFIG_DEVTMPFS=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FHANDLE=y
# CONFIG_ANDROID_PARANOID_NETWORK is not set
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_RAM=y
# Not enabled on purpose: SYSVIPC and USER_NS change struct task_struct and the namespace
# structs, which changes the modversions CRCs. Samsung's binary vendor modules (sprdwl_ng.ko
# for Wi-Fi, sprdbt_tty.ko, mali_kbase.ko in the socko partition) then refuse to load.
# CONFIG_SYSVIPC is not set
# CONFIG_USER_NS is not set
